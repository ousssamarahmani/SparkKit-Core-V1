# DATABASE_URL: Server-only PostgreSQL connection used by Prisma.
# This local value matches compose.yaml.
DATABASE_URL="postgresql://sparkkit:sparkkit@localhost:5432/sparkkit"

# BETTER_AUTH_SECRET: Server-only signing secret. Generate at least 32 random bytes.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# BETTER_AUTH_URL: Canonical URL of the Next.js reference application.
BETTER_AUTH_URL="http://localhost:3001"

# BETTER_AUTH_TRUSTED_ORIGINS: Optional comma-separated extra browser origins.
# Production values must use HTTPS. Avoid wildcards unless explicitly required.
BETTER_AUTH_TRUSTED_ORIGINS=""
