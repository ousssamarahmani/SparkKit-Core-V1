  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "incremental": false,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "exclude": ["dist", "node_modules", "tests"],
  "include": ["src/**/*.ts"],
}
