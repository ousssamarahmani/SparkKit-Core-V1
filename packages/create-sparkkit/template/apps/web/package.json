    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@sparkkit/eslint-config": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "auth": "1.7.1",
    "eslint": "^10.8.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
