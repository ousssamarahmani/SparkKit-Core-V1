{
  "name": "create-sparkkit",
  "version": "0.1.0",
  "description": "Create a portable SparkKit SaaS application.",
  "license": "Apache-2.0",
  "author": "Oussama Rahmani",
  "homepage": "https://github.com/ousssamarahmani/SparkKit-Core-V1#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ousssamarahmani/SparkKit-Core-V1.git",
    "directory": "packages/create-sparkkit"
  },
  "bugs": {
    "url": "https://github.com/ousssamarahmani/SparkKit-Core-V1/issues"
  },
  "keywords": [
    "sparkkit",
    "create-app",
    "nextjs",
    "saas",
    "typescript",
    "postgresql",
    "prisma"
  ],
  "type": "module",
  "bin": {
    "create-sparkkit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "pnpm run sync:template && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('template',{recursive:true,force:true})\"",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "pnpm run build && node scripts/verify-package.mjs",
    "sync:template": "node scripts/sync-template.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sparkkit/eslint-config": "workspace:*",
    "@types/node": "^24.10.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
