{
  "name": "sparkkit",
  "description": "Open-source foundation for portable SaaS and AI applications.",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test tests/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs --follow postgres",
    "db:up": "docker compose up --detach --wait postgres",
    "dev:docs": "pnpm --filter @sparkkit/docs dev",
    "dev:web": "pnpm --filter @sparkkit/web dev"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.9.0"
}
